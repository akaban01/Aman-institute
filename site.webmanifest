---
layout: null
---
{
  "name": {{ site.full_name | jsonify }},
  "short_name": {{ site.title | jsonify }},
  "description": {{ site.tagline | jsonify }},
  "start_url": {{ '/' | relative_url | jsonify }},
  "scope": {{ '/' | relative_url | jsonify }},
  "display": "browser",
  "background_color": "#ffffff",
  "theme_color": "#0b3d6e",
  "icons": [
    { "src": {{ '/assets/images/icons/icon-192.png' | relative_url | jsonify }}, "sizes": "192x192", "type": "image/png" },
    { "src": {{ '/assets/images/icons/icon-512.png' | relative_url | jsonify }}, "sizes": "512x512", "type": "image/png" },
    { "src": {{ '/assets/images/icons/icon-maskable-512.png' | relative_url | jsonify }}, "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
